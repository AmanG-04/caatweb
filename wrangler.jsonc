{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "caat-powerbot",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-07-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"vars": {
		"NEXT_PUBLIC_SITE_URL": "https://caatpowerbot.com",
		"NEXT_PUBLIC_COMPANY_NAME": "CAAT PowerBot LLP"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "solar-db",
			"database_id": "cf2b908f-d38d-47a2-8e7b-a14ccc21c80b",
			"migrations_dir": "db/migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "BILLS_BUCKET",
			"bucket_name": "caat-powerbot-bills"
		}
	],
	"env": {
		"staging": {
			"name": "caat-powerbot-staging",
			"vars": {
				"NEXT_PUBLIC_SITE_URL": "https://caat-powerbot-staging.10amangupta04.workers.dev",
				"NEXT_PUBLIC_COMPANY_NAME": "CAAT PowerBot LLP",
				"ENVIRONMENT": "staging"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "caat-powerbot-staging",
					"database_id": "6bcb2039-fdfb-4dde-b3b1-a1e4e13a7002",
					"migrations_dir": "db/migrations"
				}
			],
			"r2_buckets": [
				{
					"binding": "BILLS_BUCKET",
					"bucket_name": "caat-powerbot-bills-staging"
				}
			]
		}
	},
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false,
			"persist": true,
			"head_sampling_rate": 1
		}
	}
}
